node_modules/
.expo/*
# Committed on purpose: `typedRoutes` turns route strings into a union, and that
# union lives here. Without it in the repo, `npm run typecheck` on a clean CI
# checkout has no route types at all — Href degrades to a loose string and the
# check passes vacuously, catching none of the stale paths it exists to catch.
# Regenerated automatically by `expo start`; a stale copy fails the build rather
# than hiding a break, which is the safe direction.
!.expo/types/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
.env*

/android/
/ios/

/android/app/build/
/android/build/

# iOS build outputs  
/ios/build/
/ios/Pods/

modules/**/android/build/
modules/**/android/.gradle/
modules/**/ios/build/
modules/**/ios/Pods/

# EAS
.eas/build

# macOS
.DS_Store

